<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Memories</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Photos. On-device, and never uploaded. The one thing written back is the favourite
	     flag behind the heart, so that loving a photo here means the same as loving it in
	     Photos; read-write access exists for that and nothing else. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Memories reads your library on this iPhone to find and organize your memories. Photos are analyzed on device and are never uploaded.</string>

	<!--
	  Local-only background indexing. No push, no remote notifications, no APNs.

	  `fetch` is here because `BGAppRefreshTaskRequest` requires it: without it every
	  `submit` of the refresh task fails, silently, and the scheduled Lock Screen memories stop
	  being kept in step with the library. It buys no network capability — there is no network
	  code in this app — only the right to be woken briefly to recompute what tomorrow's memory
	  would be.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.justpainful.Memories.analysis</string>
		<string>com.justpainful.Memories.refresh</string>
	</array>

	<!--
	  More than one window of this app at a time, which is what an iPad user expects of anything
	  they browse in: a year open beside a place, a memory open beside the library it came from.
	  Everything shared lives on `MemoriesApp`, which is one instance however many windows there
	  are, so the second window reads the same store as the first rather than starting its own.
	-->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>

	<!--
	  IMPORTANT: UILaunchScreen must exist.

	  Without it iOS runs the app in legacy compatibility mode: the scene is letterboxed to a
	  smaller reference size, which shows up as a cropped/square screen with black bars along the
	  top and bottom on modern iPhones. An empty-but-present dict is enough to opt into full
	  native resolution and the correct safe-area insets; the color key just makes the launch
	  match the app canvas instead of flashing white.
	-->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!--
	  Orientation. The app used to declare portrait and nothing else, on iPhone only, which
	  made every landscape layout in the code unreachable and every iPad a scaled-up phone.

	  Landscape is not a nicety here. The one thing this app is for is looking at photographs
	  and watching clips, and a landscape photograph turned sideways in a portrait window is
	  shown at a third of the size the screen could give it. Upside-down is left out on iPhone
	  for the reason Apple leaves it out: the receiver is at the bottom.

	  iPad gets all four, because there is no top on an iPad.
	-->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
</dict>
</plist>
